{
    "version": "4.3.0",
    "description": "A Proxifier alternative to redirect any TCP and UDP traffic to HTTP/SOCKS5 proxy.",
    "homepage": "https://interceptsuite.com",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/InterceptSuite/ProxyBridge/releases/download/v4.3.0_Windows/ProxyBridge-Setup-4.3.0.exe#/dl.7z",
            "hash": "64992b813e4b406466540f7cc01332ef90ffe3b234719694347175fd85a3f1f9"
        }
    },
    "notes": [
        "便携模式：未注册 ProxyBridgeSvc 服务，所以每次启动都会弹 UAC，这是预期行为。",
        "scoop update proxybridge 不需要管理员：升级只换程序文件；没有管理员权限时驱动/防火墙清理会被跳过（不影响升级）。升级前请先关闭 GUI 和 CLI，否则 scoop 检测到进程会跳过更新。",
        "卸载建议用管理员终端（sudo scoop uninstall proxybridge）：运行过 GUI 后系统里有指向本应用的 WinDivert 驱动与防火墙规则，非管理员卸载会跳过清理并给出提示。",
        "程序内 Help > Check for Updates 请选 Don't Ask Again：它下载的是官方安装器，会装到 Program Files，和 scoop 版本打架。",
        "同一时间只能运行一个实例（GUI 或 CLI）。",
        "ProxyBridge_CLI 需要管理员终端运行；ProxyBridge_CLI --version 不需要管理员。",
        "Settings > Run at Startup 可以开，登录时弹 UAC 属预期；配置在 %APPDATA%\\ProxyBridge，已持久化到 scoop persist 目录。",
        "卸载不会删除 HKCU 的 Run 自启项。它指向已删除的程序，Windows 登录时会静默忽略；重装后在设置里重新勾选即可。这样也避免了在某些非常规卸载路径下误删用户偏好。",
        "WinDivert 是系统级共享内核驱动（服务名固定为 WinDivert）：只清理指向本应用目录的注册项，其他程序注册的驱动与防火墙规则保持不动。"
    ],
    "installer": {
        "script": [
            "ensure \"$persist_dir\" | Out-Null",
            "$targetPath = \"$env:APPDATA\\ProxyBridge\"",
            "$existing = Get-Item -LiteralPath $targetPath -Force -ErrorAction SilentlyContinue",
            "if ($existing) {",
            "    if ($existing.LinkType -eq 'Junction') { cmd /c rmdir \"$targetPath\" | Out-Null }",
            "    else { Get-ChildItem -LiteralPath $targetPath -Force | Move-Item -Destination $persist_dir -Force; Remove-Item -LiteralPath $targetPath -Recurse -Force }",
            "}",
            "New-Item -ItemType Junction -Path $targetPath -Target $persist_dir | Out-Null"
        ]
    },
    "post_install": "Remove-Item \"$dir\\`$PLUGINSDIR\" -Force -Recurse -ErrorAction SilentlyContinue",
    "pre_uninstall": [
        "$appName = Split-Path $app -Leaf",
        "$drv = Get-CimInstance Win32_SystemDriver -Filter \"Name='WinDivert'\" -ErrorAction SilentlyContinue",
        "$svc = Get-CimInstance Win32_Service -Filter \"Name='ProxyBridgeSvc'\" -ErrorAction SilentlyContinue",
        "$fwRules = @(Get-NetFirewallRule -DisplayName 'ProxyBridge relay*' -ErrorAction SilentlyContinue | Where-Object { ((($_ | Get-NetFirewallApplicationFilter -ErrorAction SilentlyContinue).Program) -like \"*\\apps\\$appName\\*\") })",
        "$ownedDrv = [bool]($drv -and ($drv.PathName -like \"*\\apps\\$appName\\*\"))",
        "$ownedSvc = [bool]($svc -and ($svc.PathName -like \"*\\apps\\$appName\\*\"))",
        "$pending = $ownedDrv -or $ownedSvc -or ($fwRules.Count -gt 0)",
        "if ($pending) {",
        "    if (-not (is_admin)) {",
        "        Write-Host '未以管理员运行：跳过 WinDivert 驱动 / 防火墙规则清理。需要清理时请用 sudo scoop uninstall proxybridge 或在管理员终端执行。' -ForegroundColor Yellow",
        "    } else {",
        "        if ($fwRules.Count -gt 0) { $fwRules | Remove-NetFirewallRule -ErrorAction SilentlyContinue }",
        "        if ($ownedSvc) { sc.exe stop ProxyBridgeSvc 2>$null | Out-Null; Start-Sleep -Seconds 2; sc.exe delete ProxyBridgeSvc 2>$null | Out-Null }",
        "        if ($ownedDrv) {",
        "            sc.exe stop WinDivert 2>$null | Out-Null",
        "            Start-Sleep -Seconds 2",
        "            sc.exe delete WinDivert 2>$null | Out-Null",
        "            if (Test-Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Services\\WinDivert') { Write-Host 'WinDivert 驱动仍在使用中，注册项会在重启后自动消失。' -ForegroundColor Yellow }",
        "        } elseif ($drv) {",
        "            Write-Host \"WinDivert 驱动由其他程序注册（$($drv.PathName)），保留不动。\" -ForegroundColor Yellow",
        "        }",
        "    }",
        "}"
    ],
    "uninstaller": {
        "script": [
            "$p = \"$env:APPDATA\\ProxyBridge\"",
            "$i = Get-Item -LiteralPath $p -Force -ErrorAction SilentlyContinue",
            "if ($i -and $i.LinkType -eq 'Junction') { cmd /c rmdir \"$p\" | Out-Null }",
            "elseif ($i) { Write-Host \"$p 不是 junction，按官方行为保留用户配置。\" -ForegroundColor Yellow }"
        ]
    },
    "bin": [
        [
            "ProxyBridge_CLI.exe",
            "ProxyBridge_CLI"
        ]
    ],
    "shortcuts": [
        [
            "ProxyBridge.exe",
            "Proxy Bridge"
        ]
    ],
    "checkver": {
        "github": "https://github.com/InterceptSuite/ProxyBridge",
        "jsonpath": "$..assets[?(@.browser_download_url =~ /ProxyBridge-Setup-[\\d.]+\\.exe/i)].browser_download_url",
        "regex": "download/v(?<tag>[^/]+)/ProxyBridge-Setup-(?<version>[\\d.]+)\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/InterceptSuite/ProxyBridge/releases/download/v$matchTag/ProxyBridge-Setup-$version.exe#/dl.7z"
            }
        }
    }
}
