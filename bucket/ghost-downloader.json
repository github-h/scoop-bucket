{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "4.5.4",
    "description": "Modern downloader supporting HTTP, BitTorrent/Magnet, FTP, M3U8, MPEG-DASH, eD2k, plus YouTube/Bilibili/GitHub/HuggingFace.",
    "homepage": "https://gd.xychr.com/",
    "license": "GPL-3.0-only",
    "notes": [
        "便携模式：应用程序数据（配置、日志、功能包、运行时包）位于exe文件旁边的GhostDownloader文件夹中，该文件夹会保留在Scoop的持久目录中。",
        "CLI: ghd --help (installed as the 'ghd' shim)."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/XiaoYouChR/Ghost-Downloader-3/releases/download/v4.5.4/Ghost-Downloader-v4.5.4-Windows-x86_64.zip",
            "hash": "16d4a60188dbb097b93042cab97877ec21fec8c35eb61e09fca63e4b4d358bcd"
        }
    },
    "pre_install": "New-Item -ItemType Directory -Force -Path \"$dir\\GhostDownloader\" | Out-Null",
    "bin": [
        [
            "Ghost-Downloader-3.exe",
            "ghost-downloader"
        ],
        [
            "bin\\ghd.exe",
            "ghd"
        ]
    ],
    "shortcuts": [
        [
            "Ghost-Downloader-3.exe",
            "Ghost Downloader"
        ]
    ],
    "persist": "GhostDownloader",
    "checkver": {
        "github": "https://github.com/XiaoYouChR/Ghost-Downloader-3"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/XiaoYouChR/Ghost-Downloader-3/releases/download/v$version/Ghost-Downloader-v$version-Windows-x86_64.zip"
            }
        }
    }
}
